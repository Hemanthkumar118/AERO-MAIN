VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Backend AI Services (Optional but required for AERO Intelligence)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# TomTom Maps, Live Traffic & Traffic-Aware Routing
# Supported APIs: Map Display API, Orbis Traffic Flow API Extended Tiles, 
# Orbis Traffic Incidents API Extended Tiles, Routing API, Places Search API
TOMTOM_API_KEY=your_tomtom_api_key
VITE_TOMTOM_API_KEY=your_tomtom_api_key
VITE_ROUTING_PROVIDER=tomtom

# Routing & Places Services (Fallbacks)
OSRM_BASE_URL=https://router.project-osrm.org
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Legacy Google Maps Platform (Optional fallback)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
