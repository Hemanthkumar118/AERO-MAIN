# ==============================================================================
# AERO (Ambulance Emergency Routing Operation) — Environment Configuration Template
# 
# Duplicate this file as .env (or configure variables in your hosting provider's dashboard).
# NEVER commit .env files containing real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE AUTHENTICATION & DATABASE (Frontend & Backend)
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous / publishable key (safe to expose in client-side bundles)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_anon_key

# (Optional Server-Only) Supabase Service Role Key
# REQUIRED ONLY for privileged backend admin operations. NEVER prefix with VITE_ or expose in frontend.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# ------------------------------------------------------------------------------
# 2. APPLICATION DEPLOYMENT & NETWORKING (Backend & Full-Stack)
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Server listening port (Cloud platforms like Render/Railway/Fly.io inject this automatically)
PORT=3001

# Allowed origins for Express CORS in production (comma-separated list of trusted origins)
# Example: https://aero-emergency.vercel.app,https://aero-app.netlify.app
ALLOWED_ORIGINS=https://your-production-domain.com

# ------------------------------------------------------------------------------
# 3. FRONTEND BACKEND API ROUTING (Client-side)
# ------------------------------------------------------------------------------
# Set this ONLY if deploying the frontend (Vercel/Netlify) separately from the Express backend (Render/Railway).
# If deploying as a unified single container or using same-domain reverse proxy, leave blank or omitted.
# Example: https://aero-api.onrender.com
VITE_BACKEND_URL=

# ------------------------------------------------------------------------------
# 4. AERO AI INTELLIGENCE SERVICES (Server-Only)
# ------------------------------------------------------------------------------
# Groq API key for low-latency clinical triage assistance, protocol guidance & dispatch summaries
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM model identifier (default: openai/gpt-oss-120b; automatic fallbacks: gpt-oss-20b, qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 5. MAPS, LIVE TRAFFIC & ROUTING ENGINES
# ------------------------------------------------------------------------------
# Primary Routing Provider: 'tomtom' | 'osrm' | 'openrouteservice'
VITE_ROUTING_PROVIDER=tomtom

# TomTom Maps, Live Traffic & Traffic-Aware Corridor Routing API Key
# Used for traffic flow tiles, incidents, dynamic routing, and emergency facility searches
TOMTOM_API_KEY=your_tomtom_api_key
VITE_TOMTOM_API_KEY=your_tomtom_api_key

# Fallback Routing Services
OSRM_BASE_URL=https://router.project-osrm.org
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Optional Legacy Google Maps Platform Fallback
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
